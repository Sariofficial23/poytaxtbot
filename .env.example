# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111,222222222

# ID группы, куда будут приходить заказы (начинается с -100...).
# Если пусто — заказы придут администраторам в личку.
ORDERS_CHAT_ID=

# Название заведения и контакты
CAFE_NAME=Poytaxt
CAFE_PHONE=+998 90 000 00 00
CAFE_ADDRESS=г. Ташкент, ул. Примерная, 1

# Валюта, стоимость доставки и минимальная сумма заказа
CURRENCY=сум
DELIVERY_FEE=10000
MIN_ORDER=50000

# Часы работы (HH:MM-HH:MM) и часовой сдвиг от UTC
WORK_HOURS=10:00-23:00
UTC_OFFSET=5

DB_PATH=data/bot.db
MENU_PATH=menu.json
